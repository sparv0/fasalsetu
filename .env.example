# Postgres (Neon). Pooled URL for the app, direct URL for schema pushes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Private Vercel Blob store for lot photos (optional locally; falls back to ./storage)
BLOB_READ_WRITE_TOKEN=

ACCESS_CODE=

# Gemini (optional). AI features stay off until this is set; no restart needed.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
